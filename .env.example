BAYENAT_ENVIRONMENT=development
BAYENAT_DATABASE_URL=postgresql+psycopg://bayenat:bayenat@postgres:5432/bayenat
BAYENAT_REDIS_URL=redis://redis:6379/0
BAYENAT_STORAGE_ROOT=./storage
BAYENAT_MAX_UPLOAD_SIZE_BYTES=524288000
BAYENAT_JWT_SECRET=replace-with-a-development-secret
BAYENAT_JWT_ALGORITHM=HS256
BAYENAT_ACCESS_TOKEN_MINUTES=30
BAYENAT_JWT_ISSUER=bayenat-api
BAYENAT_ALLOW_DEV_PRINCIPAL=true
BAYENAT_RATE_LIMIT_REQUESTS=120
BAYENAT_RATE_LIMIT_WINDOW_SECONDS=60
BAYENAT_WEBSOCKET_RATE_LIMIT_REQUESTS=30
BAYENAT_WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=60
BAYENAT_STT_MODEL_NAME=large-v3
BAYENAT_STT_DEVICE=cpu
BAYENAT_STT_COMPUTE_TYPE=int8
BAYENAT_STT_DEFAULT_LANGUAGE=ar
BAYENAT_STT_MODEL_VERSION=
BAYENAT_STT_DOWNLOAD_ROOT=
BAYENAT_STT_CONFIGURATION_VERSION=v1
